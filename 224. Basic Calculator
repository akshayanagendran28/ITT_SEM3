import java.util.Stack;

public class Solution {
    public int calculate(String s) {
        Stack<Integer> stack = new Stack<>();
        int result = 0;
        int number = 0;
        int sign = 1; // 1 means positive '+', -1 means negative '-'

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (Character.isDigit(c)) {
                // Form the multi-digit number
                number = 10 * number + (c - '0');
            } else if (c == '+') {
                // Add the evaluated number to the result before shifting sign
                result += sign * number;
                number = 0; // Reset the number
                sign = 1;   // Set sign to positive
            } else if (c == '-') {
                result += sign * number;
                number = 0;
                sign = -1;  // Set sign to negative
            } else if (c == '(') {
                // Push the current running result and sign onto the stack
                stack.push(result);
                stack.push(sign);
                
                // Reset result and sign for the new sub-expression
                result = 0;
                sign = 1;
            } else if (c == ')') {
                // Add the final number inside the parentheses to the sub-expression result
                result += sign * number;
                number = 0;

                // Pop the sign that was active before this parenthesis opened
                result *= stack.pop(); 
                
                // Pop the running result that was accumulated before this parenthesis opened
                result += stack.pop(); 
            }
        }

        // Add the last formed number if the string ends with a digit
        if (number != 0) {
            result += sign * number;
        }

        return result;
    }
}
