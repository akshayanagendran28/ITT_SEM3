class Solution(object):
    def characterReplacement(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: int
        """
        left = 0
        max_length = 0
        max_freq = 0
        # Frequency array for 26 uppercase English letters
        char_counts = [0] * 26
        
        # Expand the window using the right pointer
        for right in range(len(s)):
            # Increment the count of the incoming character
            char_idx = ord(s[right]) - ord('A')
            char_counts[char_idx] += 1
            
            # Track the maximum frequency of any single character seen in the current window
            max_freq = max(max_freq, char_counts[char_idx])
            
            # Window condition check: 
            # (Current Window Size) - (Count of Most Frequent Character) > k
            # If true, we need more than k replacements, making the window invalid.
            if (right - left + 1) - max_freq > k:
                # Shrink the window from the left
                char_counts[ord(s[left]) - ord('A')] -= 1
                left += 1
                
            # Keep track of the maximum valid window size found so far
            max_length = max(max_length, right - left + 1)
            
        return max_length
