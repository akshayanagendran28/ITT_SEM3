class Solution(object):
    def findMaxAverage(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: float
        """
        # Step 1: Calculate the sum of the very first window of size k
        current_window_sum = sum(nums[:k])
        max_sum = current_window_sum
        
        # Step 2: Slide the window across the rest of the array
        for i in range(k, len(nums)):
            # Add the new right-side element and subtract the old left-side element
            current_window_sum += nums[i] - nums[i - k]
            # Track the maximum sum found so far
            if current_window_sum > max_sum:
                max_sum = current_window_sum
                
        # Step 3: Return the average as a float to prevent integer division truncation
        return float(max_sum) / k
