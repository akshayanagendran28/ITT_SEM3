class Solution(object):
    def findRepeatedDnaSequences(self, s):
        """
        :type s: str
        :rtype: List[str]
        """
        # If the sequence has fewer than 10 characters, no 10-letter substring can repeat
        if len(s) < 10:
            return []
            
        seen = set()
        repeated = set()
        
        # Slide a window of size 10 across the entire string
        for i in range(len(s) - 9):
            substring = s[i:i+10]
            
            # If we have seen this sequence before, it's a duplicate
            if substring in seen:
                repeated.add(substring)
            else:
                seen.add(substring)
                
        return list(repeated)
