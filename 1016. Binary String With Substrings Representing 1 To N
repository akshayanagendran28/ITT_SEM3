class Solution(object):
    def queryString(self, s, n):
        """
        :type s: str
        :type n: int
        :rtype: bool
        """

        if n > len(s) * 2:
            return False
        for i in range(n, 0, -1):

            if bin(i)[2:] not in s:
                return False
                
        return True
