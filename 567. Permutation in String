class Solution(object):
    def checkInclusion(self, s1, s2):
        """
        :type s1: str
        :type s2: str
        :rtype: bool
        """
        len1, len2 = len(s1), len(s2)
        if len1 > len2:
            return False

        # Fixed frequency arrays for 26 lowercase English letters
        s1_counts = [0] * 26
        s2_counts = [0] * 26

        # Populate target frequencies for s1 and the initial window of s2
        for i in range(len1):
            s1_counts[ord(s1[i]) - ord('a')] += 1
            s2_counts[ord(s2[i]) - ord('a')] += 1

        # Check the very first window position
        if s1_counts == s1_counts:  # comparing initial snapshots
            if s1_counts == s2_counts:
                return True

        # Slide the window across s2 from index len1 onwards
        for i in range(len1, len2):
            # Ingest the new incoming character on the right
            s2_counts[ord(s2[i]) - ord('a')] += 1
            # Evict the outgoing character on the left
            s2_counts[ord(s2[i - len1]) - ord('a')] -= 1

            # Direct array comparison takes constant O(26) -> O(1) time
            if s1_counts == s2_counts:
                return True

        return False
