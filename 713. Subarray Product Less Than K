class Solution(object):
    def numSubarrayProductLessThanK(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        # Edge case: Since all elements in nums are positive (>= 1),
        # a product strictly less than 1 (or 0) is impossible.
        if k <= 1:
            return 0
            
        total_subarrays = 0
        current_product = 1
        left = 0
        
        # Expand the window using the right pointer
        for right in range(len(nums)):
            current_product *= nums[right]
            
            # Shrink the window from the left if the product is not strictly less than k
            while current_product >= k:
                current_product //= nums[left]
                left += 1
                
            # The number of valid subarrays ending at the 'right' index 
            # is exactly equal to the current window size.
            total_subarrays += (right - left + 1)
            
        return total_subarrays
        
