import java.util.Stack;

class MyQueue {
    private final Stack<Integer> inputStack;
    private final Stack<Integer> outputStack;

    /** Initializes your data structure here. */
    public MyQueue() {
        inputStack = new Stack<>();
        outputStack = new Stack<>();
    }
    
    /** Pushes element x to the back of the queue. */
    public void push(int x) {
        inputStack.push(x);
    }
    
    /** Removes the element from the front of the queue and returns it. */
    public int pop() {
        // Ensure outputStack has the current front elements
        shiftStacks();
        return outputStack.pop();
    }
    
    /** Returns the element at the front of the queue. */
    public int peek() {
        // Ensure outputStack has the current front elements
        shiftStacks();
        return outputStack.peek();
    }
    
    /** Returns true if the queue is empty, false otherwise. */
    public boolean empty() {
        return inputStack.isEmpty() && outputStack.isEmpty();
    }

    /**
     * Helper method to shift elements from inputStack to outputStack
     * only when outputStack runs completely empty.
     */
    private void shiftStacks() {
        if (outputStack.isEmpty()) {
            while (!inputStack.isEmpty()) {
                outputStack.push(inputStack.pop());
            }
        }
    }
}

