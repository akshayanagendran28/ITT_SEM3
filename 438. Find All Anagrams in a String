class Solution(object):
    def findAnagrams(self, s, p):
        """
        :type s: str
        :type p: str
        :rtype: List[int]
        """
        s_len, p_len = len(s), len(p)
        if s_len < p_len:
            return []

        result = []
        # FIXED: Added brackets around 0 to properly initialize the list
        p_counts = [0] * 26
        s_counts = [0] * 26

        # Populate target frequencies for p and the initial window of s
        for i in range(p_len):
            p_counts[ord(p[i]) - ord('a')] += 1
            s_counts[ord(s[i]) - ord('a')] += 1

        # Check the very first window position
        if s_counts == p_counts:
            result.append(0)

        # Slide the window across s from index 1 onwards
        for i in range(p_len, s_len):
            # Ingest the new incoming character on the right
            s_counts[ord(s[i]) - ord('a')] += 1
            # Evict the outgoing character on the left
            s_counts[ord(s[i - p_len]) - ord('a')] -= 1

            # Direct array comparison takes constant O(26) -> O(1) time
            if s_counts == p_counts:
                result.append(i - p_len + 1)

        return result
